# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# SERVER ONLY. Never expose to the client or prefix with NEXT_PUBLIC_.
# Used only by API Route back-channel jobs (e.g. Magic Link POST -> complete_via_magic_token).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Optional — only for `npm run screens` (Playwright capture). Use a dedicated TEST account, never a real one.
E2E_EMAIL=
E2E_PASSWORD=

# Optional: absolute base URL used in Magic Links (https://your-domain). Defaults to the request host.
APP_BASE_URL=
